[Unit]
Description=Mango Shield - L7 DDoS Protection & WAF
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/mango-shield
ExecStart=/opt/mango-shield/mango-shield -config /opt/mango-shield/config/production.yaml
Restart=always
RestartSec=5

# Security & Capabilities for eBPF/XDP
LimitNOFILE=1048576
LimitNPROC=65535
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_ADMIN CAP_NET_BIND_SERVICE

# Environment
Environment=GOMAXPROCS=0

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mango-shield

[Install]
WantedBy=multi-user.target
